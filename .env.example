# Copia este archivo a .env y rellena los valores.

# URL pública de la app (se usa para el callback de GitHub OAuth).
BASE_URL=http://localhost:8000

# PostgreSQL. Con compose.yaml se sobrescribe automáticamente.
DATABASE_URL=postgresql+psycopg://clicker:clicker@localhost:5432/clicker

# Puerto del PostgreSQL de Docker. Cámbialo si el 5432 está ocupado.
DB_PORT=5432

# Crea una OAuth App en https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Firma la cookie de sesión. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# Ponlo en true cuando sirvas la app por HTTPS.
COOKIE_SECURE=false

# Solo para desarrollo local: activa /auth/dev?name=tu-nombre para entrar sin GitHub.
DEV_LOGIN=false
